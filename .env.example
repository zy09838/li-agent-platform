# 环境变量示例文件
# 复制此文件为 .env.local 并填入实际值

# ==================== 开发环境配置 ====================
# 本地开发时使用
VITE_TRAINING_API=http://localhost:5001
VITE_DATASET_API=http://localhost:5002
VITE_DETECTION_API=http://localhost:5000
VITE_LLM_API=http://localhost:5004
VITE_AUDIO_API=http://localhost:5003

# ==================== 生产环境配置 ====================
# 部署到 Vercel 时配置

# 训练服务 (Railway)
# VITE_TRAINING_API=https://your-railway-app.railway.app

# LLM API
# LLM_BASE_URL=https://liai-app.chj.cloud/v1
# LLM_API_KEY=your-api-key

# Vercel Blob Storage Token
# BLOB_READ_WRITE_TOKEN=your-token

# 模型文件 URL (Vercel Blob)
# YOLO_MODEL_URL_PAINT=https://xxx.public.blob.vercel-storage.com/models/yolov8n.pt
# AUDIO_MODEL_URL=https://xxx.public.blob.vercel-storage.com/models/audio_model.pkl
