# 生产环境配置 (Vercel)
# 将此文件中的值配置到 Vercel Dashboard 的 Environment Variables 中

# ==================== 前端 API 配置 ====================
# 训练服务 API - 部署在 Railway
# 请在 Railway 部署后填入实际地址
VITE_TRAINING_API=https://your-railway-app.railway.app

# 其他服务使用 Vercel Serverless Functions（相对路径）
VITE_DATASET_API=/api
VITE_DETECTION_API=/api
VITE_LLM_API=/api
VITE_AUDIO_API=/api

# ==================== 后端服务配置 ====================
# LLM API 配置
LLM_BASE_URL=https://liai-app.chj.cloud/v1
LLM_API_KEY=app-1fPM2CPElfDesy1UNJAKTvAb

# Vercel Blob Storage
# 在 Vercel Dashboard -> Storage -> Blob 中创建后获取
BLOB_READ_WRITE_TOKEN=your-blob-token-here

# YOLO 模型 URL（存储在 Vercel Blob 中）
# 上传模型文件到 Vercel Blob 后获取 URL
YOLO_MODEL_URL_PAINT=
YOLO_MODEL_URL_ELECTRIC_DRIVE=
YOLO_MODEL_URL_GLASS=

# 音频模型 URL
AUDIO_MODEL_URL=
