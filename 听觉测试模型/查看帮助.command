#!/bin/bash
# 查看帮助文档
# 双击此文件查看使用说明

cd "$(dirname "$0")"

clear
echo "╔════════════════════════════════════════════════════════╗"
echo "║          使用帮助文档                                   ║"
echo "╚════════════════════════════════════════════════════════╝"
echo ""

if [ -f "快速开始.md" ]; then
    echo "正在显示快速开始指南..."
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    cat "快速开始.md"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
else
    echo "📖 可用的文档文件:"
    echo ""
    echo "  1. README.md - 项目总览"
    echo "  2. 快速开始.md - 5分钟入门"
    echo "  3. 脚本使用说明.md - 详细教程"
    echo "  4. 模型优化报告.md - 技术细节"
    echo "  5. 使用指南.md - 完整使用指南"
    echo ""
    echo "请使用文本编辑器打开这些文件查看。"
fi

echo ""
echo ""
echo "💡 快速提示:"
echo "  - 双击 '快速检测.command' 检测单个文件"
echo "  - 双击 '批量检测.command' 检测整个文件夹"
echo "  - 双击 '检测系统.command' 使用完整功能菜单"
echo ""

read -p "按回车键退出..."
